# Vercel (serverless) against Supabase. These are NOT read from a file on Vercel:
# set each one in Project → Settings → Environment Variables (or `vercel env add`).
# Vercel sets PORT and VERCEL itself; don't define them.
#
# Use the Supabase *Transaction* pooler (port 6543), not the Session pooler
# (5432): every function instance opens its own connections, and the Session
# pooler runs out of them quickly. Supabase → Connect → Transaction pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

POSTGRES_HOST=aws-0-us-west-2.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=postgres
POSTGRES_SSL=true
# Must stay false: the schema is managed by migrations (the app refuses to start otherwise)
DB_SYNCHRONIZE=false
# Connections per function instance (default 10 elsewhere)
POSTGRES_POOL_MAX=2

# Required: without it the app silently falls back to the dev secret
JWT_SECRET=<a-long-random-secret>
JWT_EXPIRES_IN=1h

# Migrations and the admin seed don't run on Vercel. Run them from your machine
# with .env.supabase before deploying:
#   npm run migration:run:supabase
#   npm run seed:admin:supabase
