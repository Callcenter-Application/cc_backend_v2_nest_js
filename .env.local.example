# Local Postgres (Docker). Copy to `.env.local` — the default env file.
# Used by: npm run start:dev / seed:admin / migration:*
#          docker compose --env-file .env.local --profile local up --build

# Which file `docker compose` passes to the containers (keep in sync with this file's name)
APP_ENV_FILE=.env.local
CONTAINER_NAME=callbook_api
PORT=3015

# `db` when the app runs inside Docker Compose, `localhost` when it runs on the host
POSTGRES_HOST=db
POSTGRES_NAME=callbook_db
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=callbook_db
POSTGRES_SSL=false
# Let TypeORM auto-sync the schema from the entities (local only)
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# First Administrator user created by the seed
SEED_ADMIN_EMAIL=admin@callbook.com
SEED_ADMIN_PASSWORD=Test12345@
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LASTNAME=User
