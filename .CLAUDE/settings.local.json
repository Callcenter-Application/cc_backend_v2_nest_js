{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git add:*)"
        ],
        "ask": [
            "Bash(gh pr create:*)",
            "Bash(rm:*)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Read(*.env)",
            "Bash(curl:*)"
        ],
        "defaultMode": "default"
    }
}