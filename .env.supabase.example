# Supabase (Session pooler, IPv4). Copy to `.env.supabase`.
# Used by: npm run start:dev:supabase / migration:run:supabase
#          docker compose --env-file .env.supabase up --build
# Values come from Supabase → Connect → Direct → Session pooler → URI:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Which file `docker compose` passes to the app container (keep in sync with this file's name)
APP_ENV_FILE=.env.supabase
CONTAINER_NAME=callbook_api
PORT=3015

POSTGRES_HOST=aws-0-us-west-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=postgres
POSTGRES_SSL=true
# Must stay false: the schema is managed by migrations (the app refuses to start otherwise)
DB_SYNCHRONIZE=false

JWT_SECRET=<a-long-random-secret>
JWT_EXPIRES_IN=1h
